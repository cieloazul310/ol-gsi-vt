{
  "name": "ol-vt-styles",
  "private": true,
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "packageManager": "npm@12.2.0",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@repo/eslint-config": "^1.1.2",
    "@repo/typescript-config": "^1.1.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "turbo": "^2.11.10",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "build:app": "npm run build -- --filter=./app/*",
    "build:packages": "npm run build -- --filter=./packages/*",
    "dev": "turbo run dev",
    "dev:app": "npm run dev -- --filter=./app/*",
    "dev:packages": "npm run dev -- --filter=./packages/*",
    "test": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "npm run build:packages && changeset publish",
    "lint": "turbo run lint",
    "format": "prettier --parser typescript --write \"{app,packages}/**/{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "lint-staged": "lint-staged"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
